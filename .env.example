# Environment Variables Example for HashApe PoW Mining Server
PORT=3000
NODE_ENV=production

# Supabase Cloud Database (PostgreSQL)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-optional

# Cloudflare (Optional for Tunnel or Deployment)
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-if-using-docker
