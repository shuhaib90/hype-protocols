{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hashape-mining",
  "main": "./worker.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
